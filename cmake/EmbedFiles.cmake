# Compile files into a C++ source as byte arrays.
#
#   wobo_embed_files(OUTPUT <cpp> SYMBOL <name> BASE_DIR <dir> FILES <f>...)
#
# Generates <cpp> defining
#   extern const wobo::EmbeddedFile <name>[];
#   extern const std::size_t <name>_count;
# (see src/core/embedded.h), each entry keyed by its path relative to BASE_DIR.
# The table is regenerated at build time whenever one of the files changes.
#
# The same file doubles as the script that does the generation: it is run in
# script mode (cmake -P) by the custom command below.

if(CMAKE_SCRIPT_MODE_FILE)
    file(STRINGS "${LIST_FILE}" files)
    set(out "// Generated by cmake/EmbedFiles.cmake -- do not edit.\n")
    string(APPEND out "#include \"core/embedded.h\"\n\nnamespace {\n")
    set(table "")
    set(index 0)
    foreach(f IN LISTS files)
        file(READ "${f}" hex HEX)
        string(LENGTH "${hex}" hex_len)
        math(EXPR size "${hex_len} / 2")
        string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
        # Break the initialiser into lines so compilers and editors cope.
        string(REGEX REPLACE "((0x..,){24})" "\\1\n" bytes "${bytes}")
        file(RELATIVE_PATH rel "${BASE_DIR}" "${f}")
        # A trailing NUL lets text files be used as C strings; it is not
        # counted in the size.
        string(APPEND out "const unsigned char file_${index}[] = {\n${bytes}0x00};\n")
        string(APPEND table "    {\"${rel}\", file_${index}, ${size}},\n")
        math(EXPR index "${index} + 1")
    endforeach()
    string(APPEND out "}  // namespace\n\n")
    string(APPEND out "extern const wobo::EmbeddedFile ${SYMBOL}[] = {\n${table}    {nullptr, nullptr, 0},\n};\n")
    string(APPEND out "extern const std::size_t ${SYMBOL}_count = ${index};\n")
    file(WRITE "${OUTPUT}" "${out}")
    return()
endif()

set(WOBO_EMBED_SCRIPT "${CMAKE_CURRENT_LIST_FILE}")

function(wobo_embed_files)
    cmake_parse_arguments(ARG "" "OUTPUT;SYMBOL;BASE_DIR" "FILES" ${ARGN})
    list(SORT ARG_FILES)
    set(list_file "${ARG_OUTPUT}.files")
    string(REPLACE ";" "\n" list_text "${ARG_FILES}")
    file(WRITE "${list_file}.tmp" "${list_text}\n")
    file(COPY_FILE "${list_file}.tmp" "${list_file}" ONLY_IF_DIFFERENT)
    file(REMOVE "${list_file}.tmp")

    add_custom_command(
        OUTPUT  "${ARG_OUTPUT}"
        COMMAND "${CMAKE_COMMAND}"
                "-DLIST_FILE=${list_file}"
                "-DOUTPUT=${ARG_OUTPUT}"
                "-DSYMBOL=${ARG_SYMBOL}"
                "-DBASE_DIR=${ARG_BASE_DIR}"
                -P "${WOBO_EMBED_SCRIPT}"
        DEPENDS ${ARG_FILES} "${list_file}" "${WOBO_EMBED_SCRIPT}"
        COMMENT "Embedding ${ARG_SYMBOL}"
        VERBATIM)
endfunction()
